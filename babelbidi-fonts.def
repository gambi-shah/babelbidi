\ProvidesFile{babelbidi-fonts.def}
[2026/10/26 v0.4.0 Common definitions for fonts in XeTeX and LuaTeX]


\makeatletter

% Keep fontspec's main monospaced font visible to Babel's locale resolver.
\AddToHook{package/fontspec/after}{%
    \NewCommandCopy\bbd@setmonofont\setmonofont
    \RenewDocumentCommand\setmonofont{O{} m O{}}{%
        \bbd@setmonofont[#1]{#2}[#3]%
        \ifx\babelfont\@notprerr\else
            \babelfont[\bbl@main@language]{tt}[#1,#3]{#2}%
        \fi
    }%
}



% --------------------------------------
% Main fonts
% --------------------------------------

\NewDocumentCommand{\settextfont}{O{} m}{%
    \babelfont[\bbl@main@language]{rm}[#1]{#2}%
    \babelfont[\bbl@main@language]{sf}[#1]{#2}%
    \babelfont[\bbl@main@language]{tt}[#1]{#2}%
}

\NewDocumentCommand{\setlatintextfont}{O{} m}{%
    \babelfont[\bbd@main@latin]{rm}[#1]{#2}%
    \babelfont[\bbd@main@latin]{sf}[#1]{#2}%
    \babelfont[\bbd@main@latin]{tt}[#1]{#2}%
}

\DeclareDocumentCommand \deflatinfont { m o m }
{
    \newfontfamily#1{#3}[Script=Latin,#2]
}


% --------------------------------------
% Latin sans and monospaced fonts
% --------------------------------------

\NewDocumentCommand{\setlatinsansfont}{O{} m}{%
    \babelfont[\bbd@main@latin]{sf}[#1]{#2}%
}

\NewDocumentCommand{\setlatinmonofont}{O{} m}{%
    \babelfont[\bbd@main@latin]{tt}[#1]{#2}%
}

% Resolve Babel's tt mapping with the main Latin language's font metadata.
% Only the resulting family is applied outside this local context: language,
% direction, hyphenation, and the ordinary tt default remain unchanged.
\def\bbd@apply@latin@tt#1{%
    \bbl@font@set#1\ttdefault\ttfamily
}

\DeclareRobustCommand\latinttfamily{%
    \not@math@alphabet\latinttfamily\relax
    \bbd@if@latin{\bbl@main@language}%
    \ifbbd@latin
        \ttfamily
    \else
        \begingroup
        % Babel's metadata loader uses languagename when storing INI data.
        % Set it locally so a fallback language cannot overwrite the current one.
        \edef\languagename{\bbd@main@latin}%
        \ifcsname bbl@ttdflt@\bbd@main@latin\endcsname
            \bbl@ifunset{bbl@lsys@\bbd@main@latin}{%
                \bbl@id@assign
                \bbl@provide@lsys{\bbd@main@latin}%
            }{}%
            \def\bbl@cl##1{\csname bbl@##1@\bbd@main@latin\endcsname}%
            \expandafter\bbd@apply@latin@tt
            \csname bbl@ttdflt@\bbd@main@latin\endcsname
            % Remember the origin without changing the text's locale or tt default.
            \expandafter\xdef\csname bbd@latin@tt@\ttdefault\endcsname
            {\bbd@main@latin}%
        \fi
        \edef\bbd@next{%
            \endgroup
            \noexpand\fontfamily{\ttdefault}\noexpand\selectfont
        }%
        \bbd@next
    \fi
}




\makeatother

\endinput
