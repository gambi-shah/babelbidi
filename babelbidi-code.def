\ProvidesFile{babelbidi-code.def}
[2026/10/14 v0.3.0 Code support for Babelbidi]

\makeatletter


% ------------------------------------------------
% Verbatim
% ------------------------------------------------

\def\verbatim@font{%
    \normalfont
    \ifTUTeX
        \latinttfamily
    \else
        \ttfamily\fontencoding{T1}\selectfont
    \fi
    \bbl@pardir{0}%
    \bbl@textdir{0}%
    \bbl@bodydir{0}
    \ifLuaTeX
        \ifhmode\unskip\fi
    \else
        \ifhmode\unskip\fi
        \beginL
    \fi
}

\AddToHook{env/verbatim/before}{%
    \ifLuaTeX\else\vspace{-\baselineskip}\fi
    \removelastskip
    \ifPDFTeX
        \bgroup
        \selectlanguage{\bbd@main@code}%
    \fi
}

\AddToHook{env/verbatim/after}{%
    \ifXeTeX\endL\removelastskip\fi
    \ifPDFTeX\egroup\fi
}

\g@addto@macro\verb@egroup{%
    \ifLuaTeX\else\endL\fi
}


% ------------------------------------------------
% Listings Package
% ------------------------------------------------

\@ifpackageloaded{listings}{%
    \lst@AddToHook{Init}{%
        \lst@ifdisplaystyle
        \par
        \expandafter\selectlanguage\expandafter{\bbd@main@code}%
        \else
        \ifXeTeX\unskip\fi
        \edef\bbd@tmp{%
            \noexpand\begin{otherlanguage*}{\bbd@main@code}%
        }%
        \bbd@tmp
        \ifXeTeX\beginL\fi
        \unskip
        \fi
    }
    \lst@AddToHook{DeInit}{%
        \lst@ifdisplaystyle
        \else
        \end{otherlanguage*}%
        \ifXeTeX\endL\fi
        \unskip
        \fi
    }
}{}

% ------------------------------------------------
% Minted Package
% ------------------------------------------------

\@ifpackageloaded{minted}{%
    \NewCommandCopy{\bbd@RobustMintProcess}{\RobustMintProcess}

    \RenewDocumentCommand{\RobustMintProcess}{m m m}{%
        \par
        \begin{otherlanguage}{\bbd@main@code}%
            \ifLuaTeX
                \vspace{\topsep}
                \begin{minipage}{\linewidth}%
            \fi
            \bbd@RobustMintProcess{#1}{#2}{#3}%
            \ifLuaTeX
                \end{minipage}%
                \vspace{\topsep}%
            \fi
        \end{otherlanguage}%
    }

    \NewCommandCopy{\bbd@mintinline}{\mintinline}

    \RenewDocumentCommand{\mintinline}{s O{} m m}{%
        \lr{\unskip
            \IfBooleanTF{#1}
            {%
                \bbd@mintinline*[#2]{#3}{#4}%
            }
            {%
                \bbd@mintinline[#2]{#3}{#4}%
            }%
        }\unskip
    }

    \AddToHook{env/minted/before}{%
        \par
        \begin{otherlanguage}{\bbd@main@code}%
        \ifLuaTeX
            \begin{center}
            \begin{minipage}{\linewidth}%
        \fi
    }

    \AddToHook{env/minted/after}{%
        \ifLuaTeX
            \end{minipage}%
            \end{center}
        \fi
        \end{otherlanguage}%
    }
}{}

\makeatother

\endinput
